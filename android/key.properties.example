# Release signing configuration template for Mal3abk Android App
#
# 1. Generate a keystore if you don't have one:
#    keytool -genkey -v -keystore mal3abk-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias mal3abk
#
# 2. Copy this file to `android/key.properties` (which is git-ignored):
#    cp android/key.properties.example android/key.properties
#
# 3. Fill in your real keystore path and passwords below:
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=mal3abk
storeFile=../mal3abk-release-key.jks
